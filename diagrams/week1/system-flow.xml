        <!-- ==================== LANE 1: CUSTOMER RENTAL & RETURN ==================== -->
        <mxCell id="lane_customer" value="&lt;b&gt;1. Customer Flow (ลูกค้าทั่วไป : การฝากของ &amp; การรับของคืน)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#3b82f6;strokeWidth=2;startSize=35;fontSize=13;fontColor=#1e3a8a;" vertex="1" parent="1">
