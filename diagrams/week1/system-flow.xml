        <mxCell id="c_wrong_pin" value="แจ้งเตือนรหัสผ่านไม่ถูกต้อง&lt;br&gt;(กรอกรหัสผ่านใหม่)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecaca;strokeColor=#dc2626;fontSize=11;" vertex="1" parent="lane_customer">
