<mxfile host="app.diagrams.net" agent="Gemini">
  <diagram id="RocketLockerERD" name="Crow&#39;s Foot ERD">
    <mxGraphModel dx="2071" dy="1043" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;RocketLocker System - Crow&#39;s Foot ER Diagram (Group: LockerRocket)&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" value="ระบบจัดการตู้ล็อกเกอร์ให้เช่าตามสถานที่ต่างๆ โดย &lt;b&gt;LockerSlot&lt;/b&gt; เป็น &lt;b&gt;Weak Entity&lt;/b&gt; ของ &lt;b&gt;Locker&lt;/b&gt; (ใช้ Partial Key คือ slotNumber คู่กับ lockerID เป็น Composite PK) เพราะแต่ละตู้สามารถมีเลขช่องซ้ำกันได้ (เช่น ช่อง 01, 02) และ &lt;b&gt;Rental&lt;/b&gt; เก็บค่า appliedRatePrice เป็น Snapshot ราคา ณ ตอนเช่า" vertex="1">
          <mxGeometry height="45" width="1180" x="40" y="55" as="geometry" />
        </mxCell>
        <mxCell id="brules" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" value="&lt;b&gt;Business Rules&lt;/b&gt;&lt;br&gt;1. ตู้ล็อกเกอร์ (Locker) 1 ตู้ มีช่องล็อกเกอร์ (LockerSlot) ได้หลายช่อง และช่องล็อกเกอร์ 1 ช่อง ต้องสังกัดตู้ใดตู้หนึ่งเท่านั้น (Weak Entity)&lt;br&gt;2. ลูกค้า (Customer) 1 คน สามารถเช่าตู้ได้หลายครั้ง (Rental) แต่การเช่า 1 ครั้ง เกิดจากลูกค้า 1 คน และใช้ช่องล็อกเกอร์ 1 ช่องเท่านั้น&lt;br&gt;3. การเช่า 1 ครั้ง มีการชำระเงิน (Payment) ได้ไม่เกิน 1 รายการ (0 หรือ 1) และการชำระเงิน 1 รายการ อ้างอิงการเช่า 1 ครั้งเท่านั้น&lt;br&gt;4. ผู้ดูแลระบบ (Admin) 1 คน สามารถกำหนดอัตราค่าบริการ (ServiceRate) ได้หลายรายการ และอัตราค่าบริการแต่ละรายการดูแลโดย Admin 1 คน" vertex="1">
          <mxGeometry height="90" width="1250" x="40" y="105" as="geometry" />
        </mxCell>
        <mxCell id="ent_locker" parent="1" style="shape=table;startSize=30;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Locker" vertex="1">
